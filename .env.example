# AM Preset Finder - env opsional. Gak ada secret yang dibutuhin; semua default udah jalan.
# Copy jadi .env buat lokal (jangan di-commit). Di Vercel set lewat Project Settings -> Environment Variables.

# URL feed hasil crawler GitHub Actions (branch `data`). Ganti kalau lu fork dengan nama repo beda.
AMF_FEED_URL=https://raw.githubusercontent.com/xykalnotkel/am-preset-finder/data/feed.json

# Timeout HTTP ke sumber (detik)
AMF_HTTP_TIMEOUT=15

# Maks video per request /api/scan & per daftar
AMF_MAX_SCAN_ITEMS=12
AMF_MAX_LIST_ITEMS=60

# Port server lokal (python -m amfinder serve)
PORT=8000

# XyVerse Branding
XYVERSE_LOGO_PACK=https://filebin.net/xyverse-logo-pack-9f3k2
