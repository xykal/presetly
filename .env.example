# Presetly - env opsional. Gak ada secret yang dibutuhin; semua default udah jalan.
# Copy jadi .env buat lokal (jangan di-commit). Di Vercel set lewat Project Settings -> Environment Variables.

# URL feed.json hasil crawler GitHub Actions (branch `data`). Ganti kalau lu fork dengan nama repo beda.
PRESETLY_FEED_URL=https://raw.githubusercontent.com/xykal/presetly/data/feed.json

# Timeout HTTP ke sumber (detik)
PRESETLY_HTTP_TIMEOUT=15

# Maks video per request /api/scan & per daftar
PRESETLY_MAX_SCAN_ITEMS=12
PRESETLY_MAX_LIST_ITEMS=60

# Port server lokal (python -m presetly serve)
PORT=8000

# --- Notifikasi preset baru (Web Push) ---
# Semua OPSIONAL: kalau kosong, fitur notifikasi otomatis nonaktif (web tetap jalan 100%).
# Token Cloudflare (scope D1) buat nyimpen langganan push + kunci VAPID buat enkripsi Web Push.
PRESETLY_D1_TOKEN=
PRESETLY_D1_ACCOUNT=a678fee6e0a026ccd2fd978cdf07806a
PRESETLY_D1_DB=8a43bb2d-1254-471f-b99f-55a8eee33be9
PRESETLY_VAPID_PUB=
PRESETLY_VAPID_PRIV=
PRESETLY_VAPID_SUB=mailto:xycdigital@gmail.com
# Secret buat trigger POST /api/push/run (cron) - bikin nilai random sendiri
PRESETLY_PUSH_SECRET=

# XyVerse Branding
XYVERSE_LOGO_PACK=https://filebin.net/xyverse-logo-pack-9f3k2
